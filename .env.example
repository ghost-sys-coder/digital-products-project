# Copy to .env.local for local development. Production and preview values live in Vercel,
# each scoped to exactly ONE environment. See docs/environments.md before changing anything.
#
# The app refuses to start if these values are mixed up between environments
# (lib/deployment-rules.ts). Check a file with: npm run env:check -- <file>

# production | preview | development. Must match Vercel's environment; local is development.
DEPLOYMENT_ENV=development
APP_URL=http://localhost:3000
# The live store's address, set identically everywhere. Non-production may never use it.
PRODUCTION_APP_URL=https://pod.veilcode.studio

# Outside production this MUST be a test-mode key (sk_test_/rk_test_).
STRIPE_SECRET_KEY=sk_test_...
# Local: npm run stripe:listen writes the matching listener secret to .env.local.
# Deployed: use the signing secret from that deployment's own Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Production only, and only while the store is closed to the public: permit a test key.
# ALLOW_TEST_PAYMENTS_IN_PRODUCTION=true

# Preview and development use the preview project; only production uses the production one.
SUPABASE_URL=https://<preview-project>.supabase.co
PRODUCTION_SUPABASE_URL=https://jqyewaruclxjlyouksgq.supabase.co
# Public key used for sign-in and as the API gateway key. Never a secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only service_role key of THIS environment's project.
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_BUCKET=products
# Use a separate Resend key per environment.
RESEND_API_KEY=re_...
# Required outside production: only these recipients get email. Addresses or @domains.
EMAIL_ALLOWLIST=you@example.com
# The Supabase Auth user that owns this environment's store. Use a different user for preview.
OWNER_USER_ID=<Supabase Auth owner user UUID>

# Stripe account linking. Keep disabled until OAuth and the Connect webhook are configured.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional: only for the legacy support API and old Payment Link purchases.
# Use a different random value per environment.
ADMIN_SECRET=<long random string>
STRIPE_PAYMENT_LINK_ID_L2K=
L2K_TEMPLATES_URL=
