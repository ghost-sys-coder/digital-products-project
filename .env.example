APP_URL=https://<deployment-domain>
STRIPE_SECRET_KEY=sk_test_...
# Local: npm run stripe:listen writes the matching listener secret to .env.local.
# Deployed: use the signing secret from that deployed Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_BUCKET=products
RESEND_API_KEY=re_...
OWNER_USER_ID=<Supabase Auth owner user UUID>

# Optional: only for the legacy support API and old Payment Link purchases.
ADMIN_SECRET=<long random string>
STRIPE_PAYMENT_LINK_ID_L2K=
L2K_TEMPLATES_URL=
